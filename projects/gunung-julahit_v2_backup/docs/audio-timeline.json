 "cues": [
  {
   "i": 0,
   "vo": 1,
   "beat": 1,
   "text": "Pernahkah kalian mendengar tentang sebuah gunung di Kotabaru...",
   "lines": "Pernahkah kalian mendengar tentang\nsebuah gunung di Kotabaru...",
   "start": 0.23,
   "end": 2.98
  },
  {
   "i": 1,
   "vo": 1,
   "beat": null,
   "text": "yang konon menyimpan jalan menuju dunia lain?",
   "lines": "yang konon menyimpan jalan menuju\ndunia lain?",
   "start": 2.98,
   "end": 4.98
  },
  {
   "i": 2,
   "vo": 1,
   "beat": 2,
   "text": "Namanya... Gunung Julahit.",
   "lines": "Namanya... Gunung Julahit.",
   "start": 4.98,
   "end": 5.86
  },
  {
   "i": 3,
   "vo": 1,
   "beat": 3,
   "text": "Bagi sebagian orang, mungkin ini hanya sebuah bukit biasa.",
   "lines": "Bagi sebagian orang, mungkin ini\nhanya sebuah bukit biasa.",
   "start": 6.67,
   "end": 8.54
  },
  {
   "i": 4,
   "vo": 1,
   "beat": 4,
   "text": "Namun, ada cerita lama yang sampai sekarang",
   "lines": "Namun, ada cerita lama yang sampai\nsekarang",
   "start": 8.54,
   "end": 9.98
  },
  {
   "i": 5,
   "vo": 1,
   "beat": null,
   "text": "masih menarik untuk dipertanyakan.",
   "lines": "masih menarik untuk dipertanyakan.",
   "start": 11.59,
   "end": 12.41
  },
  {
   "i": 6,
   "vo": 1,
   "beat": 5,
   "text": "Menurut penuturan seorang tokoh masyarakat bernama Yusran,",
   "lines": "Menurut penuturan seorang tokoh\nmasyarakat bernama Yusran,",
   "start": 12.93,
   "end": 14.26
  },
  {
   "i": 7,
   "vo": 1,
   "beat": 6,
   "text": "konon terdapat semacam jalur atau jembatan",
   "lines": "konon terdapat semacam jalur atau\njembatan",
   "start": 17.26,
   "end": 18.85
  },
  {
   "i": 8,
   "vo": 1,
   "beat": 7,
   "text": "yang menghubungkan Tanjung Dewa,",
   "lines": "yang menghubungkan Tanjung Dewa,",
   "start": 19.33,
   "end": 20.65
  },
  {
   "i": 9,
   "vo": 1,
   "beat": 8,
   "text": "Gunung Julahit, dan Saranjana.",
   "lines": "Gunung Julahit, dan Saranjana.",
   "start": 20.65,
   "end": 21.68
  },
  {
   "i": 10,
   "vo": 1,
   "beat": 9,
   "text": "Bahkan, ada cerita tentang sebuah... jembatan gaib.",
   "lines": "Bahkan, ada cerita tentang\nsebuah... jembatan gaib.",
   "start": 23.36,
   "end": 25.58
  },
  {
   "i": 11,
   "vo": 1,
   "beat": 10,
   "text": "Konon, jalurnya menghubungkan Tanjung Dewa...",
   "lines": "Konon, jalurnya menghubungkan\nTanjung Dewa...",
   "start": 25.58,
   "end": 27.08
  },
  {
   "i": 12,
   "vo": 1,
   "beat": null,
   "text": "menuju Gunung Julahit...",
   "lines": "menuju Gunung Julahit...",
   "start": 27.08,
   "end": 27.83
  },
  {
   "i": 13,
   "vo": 1,
   "beat": 11,
   "text": "dan berakhir di Saranjana.",
   "lines": "dan berakhir di Saranjana.",
   "start": 27.83,
   "end": 28.83
  },
  {
   "i": 14,
   "vo": 1,
   "beat": 12,
   "text": "Tiga lokasi.",
   "lines": "Tiga lokasi.",
   "start": 28.83,
   "end": 29.25
  },
  {
   "i": 15,
   "vo": 1,
   "beat": null,
   "text": "Satu jalur yang katanya tidak bisa dilihat oleh manusia biasa.",
   "lines": "Satu jalur yang katanya tidak bisa\ndilihat oleh manusia biasa.",
   "start": 31.17,
   "end": 33.0
  },
  {
   "i": 16,
   "vo": 1,
   "beat": 13,
   "text": "Tapi tunggu dulu.",
   "lines": "Tapi tunggu dulu.",
   "start": 33.0,
   "end": 33.5
  },
  {
   "i": 17,
   "vo": 1,
   "beat": null,
   "text": "Di balik cerita jembatan misterius itu,",
   "lines": "Di balik cerita jembatan misterius\nitu,",
   "start": 33.5,
   "end": 34.86
  },
  {
   "i": 18,
   "vo": 1,
   "beat": null,
   "text": "ternyata ada kisah lain yang jauh lebih menyeramkan.",
   "lines": "ternyata ada kisah lain yang jauh\nlebih menyeramkan.",
   "start": 35.68,
   "end": 37.32
  },
  {
   "i": 19,
   "vo": 1,
   "beat": 14,
   "text": "Kisah tentang seseorang yang mengaku pernah bertemu",
   "lines": "Kisah tentang seseorang yang\nmengaku pernah bertemu",
   "start": 37.32,
   "end": 39.07
  },
  {
   "i": 20,
   "vo": 1,
   "beat": null,
   "text": "seorang perempuan di sekitar Gunung Julahit.",
   "lines": "seorang perempuan di sekitar\nGunung Julahit.",
   "start": 39.07,
   "end": 40.83
  },
  {
   "i": 21,
   "vo": 1,
   "beat": 15,
   "text": "Kejadiannya berlangsung pada malam Jumat.",
   "lines": "Kejadiannya berlangsung pada malam\nJumat.",
   "start": 42.38,
   "end": 44.23
  },
  {
   "i": 22,
   "vo": 1,
   "beat": null,
   "text": "Hujan gerimis. Jalanan sepi.",
   "lines": "Hujan gerimis. Jalanan sepi.",
   "start": 44.23,
   "end": 45.3
  },
  {
   "i": 23,
   "vo": 1,
   "beat": 16,
   "text": "Dan seorang perempuan tiba-tiba melambaikan tangan",
   "lines": "Dan seorang perempuan tiba-tiba\nmelambaikan tangan",
   "start": 45.96,
   "end": 47.26
  },
  {
   "i": 24,
   "vo": 1,
   "beat": 17,
   "text": "meminta pertolongan.",
   "lines": "meminta pertolongan.",
   "start": 50.26,
   "end": 50.79
  },
  {
   "i": 25,
   "vo": 1,
   "beat": 18,
   "text": "Awalnya, semuanya terlihat biasa saja.",
   "lines": "Awalnya, semuanya terlihat biasa\nsaja.",
   "start": 51.24,
   "end": 52.34
  },
  {
   "i": 26,
   "vo": 1,
   "beat": null,
   "text": "Sampai perempuan itu menunjukkan ke mana ia ingin pulang.",
   "lines": "Sampai perempuan itu menunjukkan\nke mana ia ingin pulang.",
   "start": 52.34,
   "end": 53.67
  },
  {
   "i": 27,
   "vo": 1,
   "beat": 19,
   "text": "Ke sebuah tempat... Di atas Gunung Julahit.",
   "lines": "Ke sebuah tempat... Di atas Gunung\nJulahit.",
   "start": 54.24,
   "end": 55.16
  },
  {
   "i": 28,
   "vo": 1,
   "beat": 20,
   "text": "Dan apa yang terjadi setelahnya...",
   "lines": "Dan apa yang terjadi setelahnya...",
   "start": 55.16,
   "end": 55.9
  },
  {
   "i": 29,
   "vo": 1,
   "beat": null,
   "text": "membuat orang tersebut tidak bisa melupakan malam itu.",
   "lines": "membuat orang tersebut tidak bisa\nmelupakan malam itu.",
   "start": 56.5,
   "end": 58.34
  },
  {
   "i": 30,
   "vo": 2,
   "beat": 21,
   "text": "Menurut pemberitaan, seorang warga bernama Taufik Dani",
   "lines": "Menurut pemberitaan, seorang warga\nbernama Taufik Dani",
   "start": 59.38,
   "end": 63.4
  },
  {
   "i": 31,
   "vo": 2,
   "beat": null,
   "text": "pernah mengalami kejadian aneh di sekitar Gunung Julahit.",
   "lines": "pernah mengalami kejadian aneh di\nsekitar Gunung Julahit.",
   "start": 63.4,
   "end": 68.7
  },
  {
   "i": 32,
   "vo": 2,
   "beat": 22,
   "text": "Malam itu, ia sedang pulang.",
   "lines": "Malam itu, ia sedang pulang.",
   "start": 69.65,
   "end": 71.07
  },
  {
   "i": 33,
   "vo": 2,
   "beat": null,
   "text": "Gerimis turun. Jalanan mulai sepi.",
   "lines": "Gerimis turun. Jalanan mulai sepi.",
   "start": 71.46,
   "end": 73.59
  },
  {
   "i": 34,
   "vo": 2,
   "beat": 23,
   "text": "Di depan SMEA, yang disebut dalam pemberitaan",
   "lines": "Di depan SMEA, yang disebut dalam\npemberitaan",
   "start": 74.51,
   "end": 80.16
  },
  {
   "i": 35,
   "vo": 2,
   "beat": null,
   "text": "kini menjadi taman kota,",
   "lines": "kini menjadi taman kota,",
   "start": 81.18,
   "end": 83.1
  },
  {
   "i": 36,
   "vo": 2,
   "beat": 24,
   "text": "seorang perempuan tiba-tiba melambaikan tangan.",
   "lines": "seorang perempuan tiba-tiba\nmelambaikan tangan.",
   "start": 84.03,
   "end": 87.93
  },
  {
   "i": 37,
   "vo": 2,
   "beat": 25,
   "text": "Perempuan itu meminta ditemani pulang.",
   "lines": "Perempuan itu meminta ditemani\npulang.",
   "start": 88.97,
   "end": 91.8
  },
  {
   "i": 38,
   "vo": 2,
   "beat": 26,
   "text": "Taufik mendekat.",
   "lines": "Taufik mendekat.",
   "start": 93.11,
   "end": 94.21
  },
  {
   "i": 39,
   "vo": 2,
   "beat": 27,
   "text": "Ia bertanya, “Rumah pian di mana?”",
   "lines": "Ia bertanya, “Rumah pian di mana?”",
   "start": 96.95,
   "end": 100.22
  },
  {
   "i": 40,
   "vo": 2,
   "beat": 28,
   "text": "Namun, perempuan itu hanya menunjuk...",
   "lines": "Namun, perempuan itu hanya\nmenunjuk...",
   "start": 101.32,
   "end": 105.25
  },
  {
   "i": 41,
   "vo": 2,
   "beat": 29,
   "text": "ke arah Gunung Julahit.",
   "lines": "ke arah Gunung Julahit.",
   "start": 105.25,
   "end": 107.14
  },
  {
   "i": 42,
   "vo": 2,
   "beat": 30,
   "text": "Taufik merasa heran.",
   "lines": "Taufik merasa heran.",
   "start": 107.46,
   "end": 108.71
  },
  {
   "i": 43,
   "vo": 2,
   "beat": null,
   "text": "Baginya, tidak ada rumah di atas sana.",
   "lines": "Baginya, tidak ada rumah di atas\nsana.",
   "start": 109.39,
   "end": 113.75
  },
  {
   "i": 44,
   "vo": 2,
   "beat": 31,
   "text": "Ia pun berkata, “Saya antar sampai di bawah sini saja.”",
   "lines": "Ia pun berkata, “Saya antar sampai\ndi bawah sini saja.”",
   "start": 114.56,
   "end": 121.48
  },
  {
   "i": 45,
   "vo": 2,
   "beat": 33,
   "text": "Setelah itu...",
   "lines": "Setelah itu...",
   "start": 124.12,
   "end": 125.01
  },
  {
   "i": 46,
   "vo": 2,
   "beat": 34,
   "text": "perempuan tersebut tiba-tiba menghilang.",
   "lines": "perempuan tersebut tiba-tiba\nmenghilang.",
   "start": 125.87,
   "end": 127.65
  },
  {
   "i": 47,
   "vo": 2,
   "beat": 35,
   "text": "Tidak ada langkah menjauh. Tidak ada suara.",
   "lines": "Tidak ada langkah menjauh. Tidak\nada suara.",
   "start": 128.56,
   "end": 130.65
  },
  {
   "i": 48,
   "vo": 2,
   "beat": 36,
   "text": "Hanya jalan yang kembali kosong.",
   "lines": "Hanya jalan yang kembali kosong.",
   "start": 131.95,
   "end": 135.3
  },
  {
   "i": 49,
   "vo": 2,
   "beat": 37,
   "text": "Taufik mengaku saat itu merasa",
   "lines": "Taufik mengaku saat itu merasa",
   "start": 137.96,
   "end": 140.81
  },
  {
   "i": 50,
   "vo": 2,
   "beat": null,
   "text": "seperti setengah tidak sadar.",
   "lines": "seperti setengah tidak sadar.",
   "start": 140.81,
   "end": 142.73
  },
  {
   "i": 51,
   "vo": 2,
   "beat": null,
   "text": "Lalu, siapa perempuan itu?",
   "lines": "Lalu, siapa perempuan itu?",
   "start": 143.8,
   "end": 145.51
  },
  {
   "i": 52,
   "vo": 2,
   "beat": 38,
   "text": "Mengapa ia menunjuk Gunung Julahit?",
   "lines": "Mengapa ia menunjuk Gunung\nJulahit?",
   "start": 146.63,
   "end": 149.32
  },
  {
   "i": 53,
   "vo": 2,
   "beat": null,
   "text": "Dan apa hubungannya dengan cerita jembatan menuju Saranjana?",
   "lines": "Dan apa hubungannya dengan cerita\njembatan menuju Saranjana?",
   "start": 150.0,
   "end": 156.62
  },
  {
   "i": 54,
   "vo": 2,
   "beat": 39,
   "text": "Belum ada bukti yang memastikan bahwa peristiwa itu bersifat gaib.",
   "lines": "Belum ada bukti yang memastikan\nbahwa peristiwa itu bersifat gaib.",
   "start": 157.47,
   "end": 162.48
  },
  {
   "i": 55,
   "vo": 2,
   "beat": null,
   "text": "Yang ada adalah kesaksian yang pernah diberitakan,",
   "lines": "Yang ada adalah kesaksian yang\npernah diberitakan,",
   "start": 164.02,
   "end": 167.96
  },
  {
   "i": 56,
   "vo": 2,
   "beat": null,
   "text": "dan pertanyaan yang belum terjawab.",
   "lines": "dan pertanyaan yang belum\nterjawab.",
   "start": 168.7,
   "end": 170.84
  },
  {
   "i": 57,
   "vo": 2,
   "beat": 40,
   "text": "Menurut kalian, apa yang sebenarnya terjadi malam itu?",
   "lines": "Menurut kalian, apa yang\nsebenarnya terjadi malam itu?",
   "start": 171.8,
   "end": 175.7
  },
  {
   "i": 58,
   "vo": 2,
   "beat": null,
   "text": "Jangan lupa follow, like, komen, dan repost.",
   "lines": "Jangan lupa follow, like, komen,\ndan repost.",
   "start": 176.53,
   "end": 178.52
  },
  {
   "i": 59,
   "vo": 2,
   "beat": null,
   "text": "Punya cerita misteri Kotabaru?",
   "lines": "Punya cerita misteri Kotabaru?",
   "start": 178.52,
   "end": 179.96
  },
  {
   "i": 60,
   "vo": 2,
   "beat": null,
   "text": "Kirim DM atau ceritakan di kolom komentar.",
   "lines": "Kirim DM atau ceritakan di kolom\nkomentar.",
   "start": 180.35,
   "end": 183.01
  },
  {
   "i": 61,
   "vo": 2,
   "beat": null,
   "text": "Siapa tahu, kisah kalian jadi cerita berikutnya.",
   "lines": "Siapa tahu, kisah kalian jadi\ncerita berikutnya.",
   "start": 183.79,
   "end": 186.85
  }
