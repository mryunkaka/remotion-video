[
 {
  "start": 0.26,
  "end": 2.15,
  "text": "MISTERI PULAU HALIMUN",
  "lines": [
   "MISTERI PULAU HALIMUN"
  ],
  "unit": 0,
  "hide": true
 },
 {
  "start": 2.66,
  "end": 6.68,
  "text": "Benarkah Sebuah Pulau Lahir dari Janji Penguasa Lautan?",
  "lines": [
   "Benarkah Sebuah Pulau Lahir",
   "dari Janji Penguasa Lautan?"
  ],
  "unit": 1,
  "hide": true
 },
 {
  "start": 7.87,
  "end": 9.11,
  "text": "Pernah membayangkan...",
  "lines": [
   "Pernah membayangkan..."
  ],
  "unit": 2,
  "hide": false
 },
 {
  "start": 9.35,
  "end": 13.23,
  "text": "bagaimana jika sebuah pulau ternyata lahir dari sebuah janji?",
  "lines": [
   "bagaimana jika sebuah pulau",
   "ternyata lahir dari sebuah janji?"
  ],
  "unit": 3,
  "hide": false
 },
 {
  "start": 14.02,
  "end": 15.68,
  "text": "Bukan janji seorang raja.",
  "lines": [
   "Bukan janji seorang raja."
  ],
  "unit": 4,
  "hide": false
 },
 {
  "start": 15.97,
  "end": 18.25,
  "text": "Bukan pula hasil peperangan manusia.",
  "lines": [
   "Bukan pula hasil",
   "peperangan manusia."
  ],
  "unit": 5,
  "hide": false
 },
 {
  "start": 18.76,
  "end": 21.55,
  "text": "Melainkan janji dari penguasa lautan!",
  "lines": [
   "Melainkan janji dari",
   "penguasa lautan!"
  ],
  "unit": 6,
  "hide": false
 },
 {
  "start": 22.47,
  "end": 24.28,
  "text": "Kedengarannya mustahil, bukan?",
  "lines": [
   "Kedengarannya mustahil, bukan?"
  ],
  "unit": 7,
  "hide": false
 },
 {
  "start": 24.83,
  "end": 28.4,
  "text": "Namun, begitulah legenda yang telah diwariskan turun-temurun oleh",
  "lines": [
   "Namun, begitulah legenda yang",
   "telah diwariskan turun-temurun oleh"
  ],
  "unit": 8,
  "hide": false
 },
 {
  "start": 28.43,
  "end": 30.94,
  "text": "masyarakat Kotabaru, Kalimantan Selatan.",
  "lines": [
   "masyarakat Kotabaru,",
   "Kalimantan Selatan."
  ],
  "unit": 8,
  "hide": false
 },
 {
  "start": 31.85,
  "end": 35.35,
  "text": "Kisah ini bermula dari seorang tokoh bernama Datu Mabrur.",
  "lines": [
   "Kisah ini bermula dari seorang",
   "tokoh bernama Datu Mabrur."
  ],
  "unit": 9,
  "hide": false
 },
 {
  "start": 36.07,
  "end": 40.08,
  "text": "Konon, dahulu ia bertapa di atas sebuah batu karang di tengah lautan.",
  "lines": [
   "Konon, dahulu ia bertapa di atas",
   "sebuah batu karang di tengah lautan."
  ],
  "unit": 10,
  "hide": false
 },
 {
  "start": 40.75,
  "end": 44.6,
  "text": "Ia tidak meminta kekayaan, tidak pula menginginkan kekuasaan.",
  "lines": [
   "Ia tidak meminta kekayaan, tidak",
   "pula menginginkan kekuasaan."
  ],
  "unit": 11,
  "hide": false
 },
 {
  "start": 45.38,
  "end": 46.9,
  "text": "Permintaannya sederhana...",
  "lines": [
   "Permintaannya sederhana..."
  ],
  "unit": 12,
  "hide": false
 },
 {
  "start": 47.31,
  "end": 48.744,
  "text": "Ia hanya ingin sebuah pulau,",
  "lines": [
   "Ia hanya ingin sebuah pulau,"
  ],
  "unit": 13,
  "hide": false
 },
 {
  "start": 48.774,
  "end": 52.47,
  "text": "agar kelak anak cucunya memiliki tempat untuk hidup dan menetap.",
  "lines": [
   "agar kelak anak cucunya memiliki",
   "tempat untuk hidup dan menetap."
  ],
  "unit": 13,
  "hide": false
 },
 {
  "start": 53.31,
  "end": 54.944,
  "text": "Namun, di tengah pertapaannya,",
  "lines": [
   "Namun, di tengah pertapaannya,"
  ],
  "unit": 14,
  "hide": false
 },
 {
  "start": 54.974,
  "end": 57.63,
  "text": "tiba-tiba muncul seekor ikan todak raksasa!",
  "lines": [
   "tiba-tiba muncul seekor",
   "ikan todak raksasa!"
  ],
  "unit": 14,
  "hide": false
 },
 {
  "start": 58.3,
  "end": 61.596,
  "text": "Makhluk laut yang dalam legenda dikenal sebagai penguasa perairan",
  "lines": [
   "Makhluk laut yang dalam legenda",
   "dikenal sebagai penguasa perairan"
  ],
  "unit": 15,
  "hide": false
 },
 {
  "start": 61.626,
  "end": 63.52,
  "text": "itu datang menyerang Datu Mabrur.",
  "lines": [
   "itu datang menyerang",
   "Datu Mabrur."
  ],
  "unit": 15,
  "hide": false
 },
 {
  "start": 64.21,
  "end": 65.64,
  "text": "Pertarungan pun pecah!",
  "lines": [
   "Pertarungan pun pecah!"
  ],
  "unit": 16,
  "hide": false
 },
 {
  "start": 66.01,
  "end": 67.88,
  "text": "Serangan demi serangan terjadi.",
  "lines": [
   "Serangan demi",
   "serangan terjadi."
  ],
  "unit": 17,
  "hide": false
 },
 {
  "start": 68.04,
  "end": 71.46,
  "text": "Hingga akhirnya, ikan todak raksasa itu berhasil dikalahkan.",
  "lines": [
   "Hingga akhirnya, ikan todak",
   "raksasa itu berhasil dikalahkan."
  ],
  "unit": 18,
  "hide": false
 },
 {
  "start": 71.92,
  "end": 75.35,
  "text": "Tetapi, sesuatu yang tidak terduga justru terjadi setelahnya.",
  "lines": [
   "Tetapi, sesuatu yang tidak",
   "terduga justru terjadi setelahnya."
  ],
  "unit": 19,
  "hide": false
 },
 {
  "start": 75.79,
  "end": 78.11,
  "text": "Datu Mabrur tidak membunuh makhluk tersebut.",
  "lines": [
   "Datu Mabrur tidak",
   "membunuh makhluk tersebut."
  ],
  "unit": 20,
  "hide": false
 },
 {
  "start": 78.35,
  "end": 82.0,
  "text": "Ia malah mengobati luka-lukanya dan melepaskannya kembali ke lautan.",
  "lines": [
   "Ia malah mengobati luka-lukanya dan",
   "melepaskannya kembali ke lautan."
  ],
  "unit": 21,
  "hide": false
 },
 {
  "start": 82.43,
  "end": 84.43,
  "text": "Sang Raja Ikan Todak pun terkejut.",
  "lines": [
   "Sang Raja Ikan",
   "Todak pun terkejut."
  ],
  "unit": 22,
  "hide": false
 },
 {
  "start": 84.55,
  "end": 86.315,
  "text": "Sebagai balasan atas kebaikan itu,",
  "lines": [
   "Sebagai balasan",
   "atas kebaikan itu,"
  ],
  "unit": 23,
  "hide": false
 },
 {
  "start": 86.345,
  "end": 88.09,
  "text": "ia menawarkan sebuah hadiah.",
  "lines": [
   "ia menawarkan sebuah hadiah."
  ],
  "unit": 23,
  "hide": false
 },
 {
  "start": 88.43,
  "end": 91.1,
  "text": "Dan tahukah kalian apa yang diminta Datu Mabrur?",
  "lines": [
   "Dan tahukah kalian apa",
   "yang diminta Datu Mabrur?"
  ],
  "unit": 24,
  "hide": false
 },
 {
  "start": 91.47,
  "end": 93.23,
  "text": "Ia tetap meminta hal yang sama...",
  "lines": [
   "Ia tetap meminta",
   "hal yang sama..."
  ],
  "unit": 25,
  "hide": false
 },
 {
  "start": 93.38,
  "end": 95.38,
  "text": "Sebuah pulau untuk anak cucunya.",
  "lines": [
   "Sebuah pulau untuk",
   "anak cucunya."
  ],
  "unit": 26,
  "hide": false
 },
 {
  "start": 95.77,
  "end": 98.798,
  "text": "Konon, Raja Ikan Todak kemudian memanggil seluruh penghuni lautan",
  "lines": [
   "Konon, Raja Ikan Todak kemudian",
   "memanggil seluruh penghuni lautan"
  ],
  "unit": 27,
  "hide": false
 },
 {
  "start": 98.828,
  "end": 101.6,
  "text": "untuk bersama-sama mengangkat daratan dari dasar laut.",
  "lines": [
   "untuk bersama-sama mengangkat",
   "daratan dari dasar laut."
  ],
  "unit": 27,
  "hide": false
 },
 {
  "start": 101.88,
  "end": 104.74,
  "text": "Hingga akhirnya, muncullah sebuah pulau yang dikenal dalam hikayat",
  "lines": [
   "Hingga akhirnya, muncullah sebuah",
   "pulau yang dikenal dalam hikayat"
  ],
  "unit": 28,
  "hide": false
 },
 {
  "start": 104.77,
  "end": 108.2,
  "text": "sebagai Pulau Halimun, yang dikaitkan dengan Pulau Laut di Kotabaru.",
  "lines": [
   "sebagai Pulau Halimun, yang dikaitkan",
   "dengan Pulau Laut di Kotabaru."
  ],
  "unit": 28,
  "hide": false
 },
 {
  "start": 108.39,
  "end": 110.71,
  "text": "Dari semangat kebersamaan dalam kisah inilah,",
  "lines": [
   "Dari semangat kebersamaan",
   "dalam kisah inilah,"
  ],
  "unit": 29,
  "hide": false
 },
 {
  "start": 110.74,
  "end": 112.454,
  "text": "kita mengenal filosofi Saijaan,",
  "lines": [
   "kita mengenal",
   "filosofi Saijaan,"
  ],
  "unit": 29,
  "hide": false
 },
 {
  "start": 112.484,
  "end": 115.77,
  "text": "yang berarti seiya sekata dan menjadi semboyan Kabupaten Kotabaru.",
  "lines": [
   "yang berarti seiya sekata dan",
   "menjadi semboyan Kabupaten Kotabaru."
  ],
  "unit": 29,
  "hide": false
 },
 {
  "start": 116.11,
  "end": 117.59,
  "text": "Tentu, kisah ini merupakan legenda,",
  "lines": [
   "Tentu, kisah ini",
   "merupakan legenda,"
  ],
  "unit": 30,
  "hide": false
 },
 {
  "start": 117.62,
  "end": 120.49,
  "text": "bukan bukti ilmiah tentang terbentuknya Pulau Laut.",
  "lines": [
   "bukan bukti ilmiah tentang",
   "terbentuknya Pulau Laut."
  ],
  "unit": 30,
  "hide": false
 },
 {
  "start": 120.69,
  "end": 123.49,
  "text": "Namun, ada satu pertanyaan yang menarik untuk kita renungkan...",
  "lines": [
   "Namun, ada satu pertanyaan yang",
   "menarik untuk kita renungkan..."
  ],
  "unit": 31,
  "hide": false
 },
 {
  "start": 123.58,
  "end": 126.344,
  "text": "Jika sebuah pulau dalam legenda lahir dari janji dan kebersamaan,",
  "lines": [
   "Jika sebuah pulau dalam legenda",
   "lahir dari janji dan kebersamaan,"
  ],
  "unit": 32,
  "hide": false
 },
 {
  "start": 126.374,
  "end": 129.32,
  "text": "apakah kita masih menjaga semangat itu sampai hari ini?",
  "lines": [
   "apakah kita masih menjaga",
   "semangat itu sampai hari ini?"
  ],
  "unit": 32,
  "hide": false
 },
 {
  "start": 129.49,
  "end": 130.45,
  "text": "Bagaimana menurut kalian?",
  "lines": [
   "Bagaimana menurut kalian?"
  ],
  "unit": 33,
  "hide": false
 },
 {
  "start": 130.48,
  "end": 132.67,
  "text": "Tulis pendapat kalian di kolom komentar!",
  "lines": [
   "Tulis pendapat kalian",
   "di kolom komentar!"
  ],
  "unit": 33,
  "hide": false
 },
 {
  "start": 132.8,
  "end": 135.215,
  "text": "Dan kalau kalian punya cerita misteri atau legenda dari daerah",
  "lines": [
   "Dan kalau kalian punya cerita",
   "misteri atau legenda dari daerah"
  ],
  "unit": 34,
  "hide": false
 },
 {
  "start": 135.245,
  "end": 137.39,
  "text": "sendiri, jangan ragu untuk membagikannya.",
  "lines": [
   "sendiri, jangan ragu",
   "untuk membagikannya."
  ],
  "unit": 34,
  "hide": false
 },
 {
  "start": 137.52,
  "end": 139.325,
  "text": "Jangan lupa LIKE, FOLLOW @terangbulan.media,",
  "lines": [
   "Jangan lupa LIKE, FOLLOW",
   "@terangbulan.media,"
  ],
  "unit": 35,
  "hide": false
 },
 {
  "start": 139.355,
  "end": 143.03,
  "text": "dan SHARE video ini agar semakin banyak cerita Nusantara yang tidak terlupakan.",
  "lines": [
   "dan SHARE video ini agar semakin banyak",
   "cerita Nusantara yang tidak terlupakan."
  ],
  "unit": 35,
  "hide": false
 },
 {
  "start": 143.12,
  "end": 144.12,
  "text": "Karena siapa tahu...",
  "lines": [
   "Karena siapa tahu..."
  ],
  "unit": 36,
  "hide": false
 },
 {
  "start": 144.15,
  "end": 146.51,
  "text": "legenda berikutnya justru berasal dari daerah kalian.",
  "lines": [
   "legenda berikutnya justru",
   "berasal dari daerah kalian."
  ],
  "unit": 37,
  "hide": false
 },
 {
  "start": 146.63,
  "end": 147.36,
  "text": "Terang Bulan",
  "lines": [
   "Terang Bulan"
  ],
  "unit": 38,
  "hide": true
 },
 {
  "start": 147.42,
  "end": 149.21,
  "text": "Mengungkap Cerita, Menerangi Makna.",
  "lines": [
   "Mengungkap Cerita,",
   "Menerangi Makna."
  ],
  "unit": 39,
  "hide": true
 }
]